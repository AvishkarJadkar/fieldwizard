# FieldWizard configuration
# Copy to .env and fill in what you need. The app runs without any of these.

# --- LLM coaching report ---------------------------------------------------
# Free tier: https://aistudio.google.com/apikey
# Without a key the report falls back to a deterministic rules engine.
GEMINI_API_KEY=
# Optional overrides
# FW_LLM_KEY=
# FW_LLM_MODEL=gemini-2.5-flash

# --- Analysis window ------------------------------------------------------
# Seconds to analyse (clip mode). Raise these for longer footage.
FW_START_SECONDS=0
FW_MAX_SECONDS=20
FW_ANALYSIS_FPS=15

# --- Model -----------------------------------------------------------------
# Football-specific detector (ball / goalkeeper / player / referee).
# Falls back to yolo11n.pt if the file is missing.
FW_MODEL=models/football_v8.pt

# --- Optional features -----------------------------------------------------
# Jersey OCR is off by default: wide tactical shots rarely have legible numbers.
FW_JERSEY=0

# Max upload size in MB (API only)
FW_MAX_UPLOAD_MB=4096
